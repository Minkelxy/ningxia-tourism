{
  "name": "workspace",
  "private": true,
  "version": "0.3.94",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "process:images": "tsx scripts/process-images.ts",
    "simplify:map": "tsx scripts/simplify-geojson.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "validate:data:reminder": "tsx scripts/check-verification-reminder.ts",
    "validate:data:reminder:ci": "tsx scripts/check-verification-reminder.ts --format=json",
    "content:lint": "tsx scripts/content-lint.ts",
    "new:article": "tsx scripts/new-article.ts",
    "build": "npm run validate:data && tsc -b && vite build && tsx scripts/generate-sitemap.ts",
    "verify:pages-fallback": "tsx scripts/verify-pages-fallback.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit": "npm audit --audit-level=high",
    "quality:lighthouse": "tsx scripts/run-lighthouse.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "lighthouse": "^13.4.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "yaml": "^2.8.1"
  }
}
